CONFIG_CPU_BIG_ENDIAN=y
CONFIG_CPU_MIPS32_R2=y
CONFIG_HIGHMEM=y
# Same overlay-related options as the TL-WR740N kernel (../build/kernel-trim.config): xattrs on, no ACLs or security labels
CONFIG_JFFS2_FS_XATTR=y
CONFIG_TMPFS_XATTR=y
# Test only: block2mtd, so tests.sh can put a JFFS2 overlay upper layer on an IDE disk
CONFIG_MTD_BLOCK2MTD=y
