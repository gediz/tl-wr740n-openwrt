diff --git a/target/linux/ath79/tiny/config-default b/target/linux/ath79/tiny/config-default
index 38fbe1b..4275ee3 100644
--- a/target/linux/ath79/tiny/config-default
+++ b/target/linux/ath79/tiny/config-default
@@ -6,3 +6,109 @@ CONFIG_NVMEM_SYSFS=y
 CONFIG_NVMEM_U_BOOT_ENV=y
 CONFIG_PHYLINK=y
 CONFIG_REGULATOR_FIXED_VOLTAGE=y
+# ---- kernel-trim.config: appended to target/linux/ath79/tiny/config-default ----
+# Core / memory
+# CONFIG_SYSVIPC is not set
+# CONFIG_BPF_SYSCALL is not set
+# CONFIG_BPF_JIT is not set
+# CONFIG_ADVISE_SYSCALLS is not set
+# CONFIG_BASE_FULL is not set
+# CONFIG_SYMBOLIC_ERRNAME is not set
+# CONFIG_SYSCTL_EXCEPTION_TRACE is not set
+# CONFIG_LRU_GEN is not set
+CONFIG_SLUB_TINY=y
+# CONFIG_SLAB_FREELIST_RANDOM is not set
+# CONFIG_SLAB_FREELIST_HARDENED is not set
+# CONFIG_HARDENED_USERCOPY is not set
+# CONFIG_FORTIFY_SOURCE is not set
+# CONFIG_LIST_HARDENED is not set
+# CONFIG_SCHED_STACK_END_CHECK is not set
+# CONFIG_EARLY_PRINTK is not set
+# CONFIG_RUNTIME_TESTING_MENU is not set
+# CONFIG_UEVENT_HELPER is not set
+# CONFIG_FW_LOADER_USER_HELPER is not set
+# CONFIG_ALLOW_DEV_COREDUMP is not set
+# CONFIG_DEVPORT is not set
+# CONFIG_ISDN is not set
+# CONFIG_STAGING is not set
+# Block / partitions (squashfs on mtdblock still needs BLOCK)
+CONFIG_PARTITION_ADVANCED=y
+# CONFIG_MSDOS_PARTITION is not set
+# CONFIG_EFI_PARTITION is not set
+# CONFIG_OF_PARTITION is not set
+# CONFIG_SCSI_MOD is not set
+# Bus: no PCI / USB on AR9331 board
+# CONFIG_PCI is not set
+# CONFIG_PCI_AR71XX is not set
+# CONFIG_PCI_AR724X is not set
+# CONFIG_USB_SUPPORT is not set
+# Networking
+# CONFIG_AF_UNIX_OOB is not set
+# CONFIG_IP_ADVANCED_ROUTER is not set
+# CONFIG_IP_MULTIPLE_TABLES is not set
+# CONFIG_IP_ROUTE_MULTIPATH is not set
+# CONFIG_IP_ROUTE_VERBOSE is not set
+# CONFIG_IP_MROUTE is not set
+# CONFIG_TCP_CONG_ADVANCED is not set
+# CONFIG_NETFILTER is not set
+# CONFIG_BRIDGE_IGMP_SNOOPING is not set
+# CONFIG_NET_SWITCHDEV is not set
+# CONFIG_NET_DEVLINK is not set
+# CONFIG_NET_RX_BUSY_POLL is not set
+# CONFIG_NET_SELFTESTS is not set
+# CONFIG_RFKILL is not set
+# CONFIG_TEXTSEARCH is not set
+# Ethernet / PHY: AR9331 builtin switch (qca,ar7240sw) needs AR8216_PHY + swconfig
+# CONFIG_AG71XX_LEGACY_DEBUG_FS is not set
+CONFIG_AR8216_PHY=y
+# CONFIG_AR8216_PHY_LEDS is not set
+# CONFIG_AT803X_PHY is not set
+# CONFIG_QCOM_NET_PHYLIB is not set
+# CONFIG_MDIO_BITBANG is not set
+# CONFIG_MDIO_GPIO is not set
+# CONFIG_PHYLINK is not set
+# CONFIG_GRO_CELLS is not set
+# MTD: only TP-Link fw splitter + squashfs root
+# CONFIG_MTD_SPLIT_SEAMA_FW is not set
+# CONFIG_MTD_SPLIT_WRGG_FW is not set
+# CONFIG_MTD_SPLIT_UIMAGE_FW is not set
+# CONFIG_MTD_SPLIT_LZMA_FW is not set
+# CONFIG_MTD_SPLIT_ELF_FW is not set
+# CONFIG_MTD_CMDLINE_PARTS is not set
+# CONFIG_MTD_PARSER_CYBERTAN is not set
+# CONFIG_MTD_CFI is not set
+# CONFIG_MTD_JEDECPROBE is not set
+# CONFIG_MTD_PHYSMAP is not set
+# CONFIG_MTD_COMPLEX_MAPPINGS is not set
+# CONFIG_MTD_VIRT_CONCAT is not set
+# Serial / SPI / GPIO (flash sits on qca,ar934x-spi: SPI_AR934X must stay on)
+# CONFIG_SERIAL_8250 is not set
+# CONFIG_SERIAL_MCTRL_GPIO is not set
+CONFIG_SPI_AR934X=y
+# CONFIG_SPI_BITBANG is not set
+# CONFIG_SPI_GPIO is not set
+# CONFIG_GPIO_74X164 is not set
+# CONFIG_GPIO_CDEV is not set
+# CONFIG_REGULATOR is not set
+# CONFIG_NVMEM_U_BOOT_ENV is not set
+# CONFIG_NVMEM_LAYOUT_U_BOOT_ENV is not set
+# LEDs: keep timer/default-on/netdev (+ mac80211/swconfig triggers)
+# CONFIG_LEDS_TRIGGER_HEARTBEAT is not set
+# CONFIG_LEDS_CLASS_MULTICOLOR is not set
+# CONFIG_LEDS_BRIGHTNESS_HW_CHANGED is not set
+# Filesystems: xattrs on so overlayfs can store whiteouts and opaque dirs (rmdir, rename, mkdir over a whiteout)
+CONFIG_JFFS2_FS_XATTR=y
+CONFIG_TMPFS_XATTR=y
+# Lib
+# CONFIG_CRC32_SLICEBY8 is not set
+CONFIG_CRC32_SARWATE=y
+# CONFIG_DEBUG_INFO is not set
+CONFIG_DEBUG_INFO_NONE=y
+# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
+# Round 2
+# CONFIG_BLK_DEV_INITRD is not set
+# CONFIG_ETHTOOL_NETLINK is not set
+# CONFIG_SYN_COOKIES is not set
+CONFIG_LOG_BUF_SHIFT=14
+# Round 3
+# CONFIG_BUG is not set
