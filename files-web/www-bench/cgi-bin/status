#!/bin/sh
. /usr/lib/benchweb.sh
need GET
read up _ < /proc/uptime
read l1 l5 l15 _ < /proc/loadavg
ok "$(printf '{"uptime":%s,"load":[%s,%s,%s],"mem_kb":{"total":%s,"available":%s},"firmware":"%s","kernel":"%s","lan_ip":"%s","ports":%s,"wifi":%s,"netem":%s}' \
	${up%.*} $l1 $l5 $l15 $(awk '/^MemTotal:/{print $2}' /proc/meminfo) $(memavail) \
	"$(js "$(sed -n "s/^DISTRIB_DESCRIPTION='\(.*\)'/\1/p" /etc/openwrt_release)")" "$(uname -r)" \
	"$(uci -q get network.lan.ipaddr)" "$(ports_json)" "$(wifi_json)" "$(netem_json)")"
